{
  "name": "javascript-bridge",
  "version": "1.0.4",
  "description": "A desktop environment for JavaScript-based applications such as P5 that enables additional serial and TCP/IP-based communication.",
  "license": "MIT",
  "author": "Yonatan Rozin",
  "type": "commonjs",
  "main": "main/dist/index.js",
  "scripts": {
    "start": "electron ./main/dist/index",
    "build": "electron-builder build",
    "dev": "concurrently \"tsc --watch\" \"nodemon --watch main/dist --exec electron ./main/dist/index\""
  },
  "build": {
    "appId": "com.yonatanrozin.jsbridge",
    "files": [
      "main/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "sketch",
        "to": "sketch"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/serialport": "^8.0.5",
    "concurrently": "^10.0.6",
    "electron": "^41.3.0",
    "electron-builder": "^26.5.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "artnet": "^1.4.0",
    "node-osc": "^11.7.1",
    "osc-js": "^2.4.1",
    "serialport": "^13.0.0"
  }
}
